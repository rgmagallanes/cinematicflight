    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst errors = [];\nconst text = (value, max) => typeof value === 'string' ? value.trim().slice(0, max) : '';\nconst name = text(input.name, 100);\nconst email = text(input.email, 254).toLowerCase();\nconst property = text(input.property, 160);\nconst purpose = text(input.purpose, 80);\nconst start = text(input.start, 40);\nconst end = text(input.end, 40);\nconst timezone = text(input.timezone, 60) || 'Asia/Manila';\nconst requestId = text(input.requestId, 100);\nconst allowedPurposes = ['Photograph reading', 'New property website', 'Add the cinematic experience'];\nif (!name) errors.push('Name is required.');\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('A valid email is required.');\nif (!allowedPurposes.includes(purpose)) errors.push('Choose a valid conversation type.');\nif (!requestId) errors.push('A request ID is required.');\nconst startDate = new Date(start);\nconst endDate = new Date(end);\nif (!start || Number.isNaN(startDate.getTime())) errors.push('A valid start time is required.');\nif (!end || Number.isNaN(endDate.getTime()) || endDate <= startDate) errors.push('A valid end time is required.');\nif (timezone !== 'Asia/Manila') errors.push('The booking timezone must be Asia/Manila.');\nreturn [{ json: { valid: errors.length === 0, errors, requestId, name, email, property, purpose, start, end, timezone, receivedAt: new Date().toISOString(), source: 'cinematicflight.com/book' } }];"
      },
